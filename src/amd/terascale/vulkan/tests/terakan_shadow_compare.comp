#version 450

layout(local_size_x = 8, local_size_y = 8) in;

/* Depth-comparison ("shadow") sampling: the texture unit compares a reference value supplied with
 * the coordinates against the stored depth and returns 0.0 or 1.0, rather than returning the depth
 * itself. This is what every shadow map in a real renderer is built on -- Godot's frames are
 * dominated by depth-only shadow passes whose results are consumed exactly this way -- and nothing
 * else in this suite exercises it.
 *
 * The reference sweeps across x while the stored depth is uniform, so one dispatch checks the
 * comparison on both sides of the stored value and at equality.
 */
layout(set = 0, binding = 0) uniform sampler2DShadow shadow_map;

layout(set = 0, binding = 1, std430) writeonly buffer Output {
   float values[];
} output_data;

layout(push_constant) uniform Push {
   uint width;
   uint height;
} push;

void
main()
{
   uvec2 position = gl_GlobalInvocationID.xy;
   if (position.x >= push.width || position.y >= push.height)
      return;
   uint linear_index = position.y * push.width + position.x;
   float reference = float(position.x) / float(push.width);
   vec2 coordinates = (vec2(position) + 0.5) / vec2(push.width, push.height);
   /* Compute has no implicit derivatives, so the level has to be explicit. */
   output_data.values[linear_index] = textureLod(shadow_map, vec3(coordinates, reference), 0.0);
}
