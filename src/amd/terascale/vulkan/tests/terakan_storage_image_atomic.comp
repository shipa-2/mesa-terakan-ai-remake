#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

/* A handful of R32_UINT texels shared by every invocation across every workgroup, each hit with a
 * different atomic op. If storage-image atomics are actually implemented as real RAT atomic
 * operations (rather than lowered to a racy load-modify-store), the results are exact and
 * independent of how many workgroups run concurrently:
 *   (0,0) atomicAdd 1 from every invocation -> total invocation count.
 *   (1,0) atomicMin against each invocation's own unique global index -> 0.
 *   (2,0) atomicMax against each invocation's own unique global index -> invocation count - 1.
 *   (3,0) atomicExchange with each invocation's own unique global index + 1 (0 is the image's
 *         initial value, so a racy read-modify-write that silently drops a write would still be
 *         caught by expecting a nonzero, otherwise-valid value in range).
 */
layout(set = 0, binding = 0, r32ui) uniform uimage2D counters;

layout(push_constant) uniform PushConstants {
   uint invocations_per_workgroup;
} push_constants;

void
main()
{
   uint global_index =
      gl_WorkGroupID.x * push_constants.invocations_per_workgroup + gl_LocalInvocationID.x;
   imageAtomicAdd(counters, ivec2(0, 0), 1u);
   imageAtomicMin(counters, ivec2(1, 0), global_index);
   imageAtomicMax(counters, ivec2(2, 0), global_index);
   imageAtomicExchange(counters, ivec2(3, 0), global_index + 1u);
}
