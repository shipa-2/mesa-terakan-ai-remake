#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/* A multisample color image bound as an ordinary multisample texture. Unlike depth (which uses no
 * compression on Evergreen since Terakan does not implement HTILE), a multisample color surface's
 * per-sample layout is addressed through FMASK, so this probes whether FMASK-based per-sample
 * texture reads actually work, not just whether the memory layout and identity initialization
 * build and run without a hang (which terakan_image.c already establishes separately).
 */
layout(set = 0, binding = 0) uniform sampler2DMS source_color;

layout(set = 0, binding = 1, std430) writeonly buffer Output {
   vec4 values[];
} output_buffer;

layout(push_constant) uniform PushConstants {
   uint width;
   uint height;
   uint sample_count;
} push_constants;

void
main()
{
   uvec2 coordinate = gl_GlobalInvocationID.xy;
   if (coordinate.x >= push_constants.width || coordinate.y >= push_constants.height)
      return;

   uint base = (coordinate.y * push_constants.width + coordinate.x) * push_constants.sample_count;
   for (uint sample_index = 0; sample_index < push_constants.sample_count; ++sample_index) {
      output_buffer.values[base + sample_index] =
         texelFetch(source_color, ivec2(coordinate), int(sample_index));
   }
}
