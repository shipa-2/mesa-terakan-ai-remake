#!/usr/bin/env bash
set -euo pipefail

source_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo_root=$(cd -- "$(dirname -- "$source_path")/.." && pwd -P)
terakan_runner="$repo_root/bin/terakan-run"
dxvk_dir=${TERAKAN_DXVK_DIR:-}
use_dxvk=true
created_dxvk_links=()

usage() {
  cat <<'EOF'
usage: steam-terakan-run [OPTIONS] COMMAND [ARG ...]
       steam-terakan-run --install
       steam-terakan-run --doctor

Steam launch option:
  steam-terakan-run %command%

Options:
  --dxvk-sarek DIR  use 64-bit DXVK-Sarek DLLs from DIR
  --no-dxvk-sarek   don't alter WINEDLLPATH or WINEDLLOVERRIDES
  --install         link this launcher into ~/.local/bin
  --doctor          print resolved paths and validate the local build
  -h, --help        show this help

Environment:
  TERAKAN_BUILD_DIR  override the Mesa build directory (used by terakan-run)
  TERAKAN_DXVK_DIR   override the DXVK-Sarek x64 directory
EOF
}

install_launcher() {
  local install_dir=${XDG_BIN_HOME:-"$HOME/.local/bin"}
  local install_path="$install_dir/steam-terakan-run"
  local steam_game_bin="$HOME/.local/share/Steam/ubuntu12_32/steam-runtime/game-bin"

  mkdir -p -- "$install_dir"
  install_link "$install_path"

  # A Steam process started by a desktop launcher often doesn't inherit ~/.local/bin. Its legacy
  # runtime prepends game-bin to every launch command, so place the same safe symlink there when
  # that user-owned directory exists. Steam updates may recreate this directory; --install is
  # intentionally idempotent.
  if [[ -d "$steam_game_bin" && -w "$steam_game_bin" ]]; then
    install_link "$steam_game_bin/steam-terakan-run"
  fi

  case ":${PATH:-}:" in
    *":$install_dir:"*) ;;
    *)
      printf 'Warning: %s is not in this shell PATH.\n' "$install_dir" >&2
      ;;
  esac
}

install_link() {
  local install_path=$1
  if [[ -e "$install_path" || -L "$install_path" ]]; then
    local installed_source
    installed_source=$(readlink -f -- "$install_path" 2>/dev/null || true)
    if [[ "$installed_source" != "$source_path" ]]; then
      echo "steam-terakan-run: refusing to replace $install_path" >&2
      exit 1
    fi
  else
    ln -s -- "$source_path" "$install_path"
  fi

  printf 'Installed: %s -> %s\n' "$install_path" "$source_path"
}

resolve_dxvk() {
  if [[ -z "$dxvk_dir" ]]; then
    local sibling_dxvk="$repo_root/../DXVK-Sarek/x64"
    if [[ -r "$sibling_dxvk/dxgi.dll" && -r "$sibling_dxvk/d3d11.dll" ]]; then
      dxvk_dir=$(cd -- "$sibling_dxvk" && pwd -P)
    fi
  else
    dxvk_dir=$(cd -- "$dxvk_dir" 2>/dev/null && pwd -P) || {
      echo "steam-terakan-run: DXVK-Sarek directory does not exist: $dxvk_dir" >&2
      exit 1
    }
    if [[ ! -r "$dxvk_dir/dxgi.dll" || ! -r "$dxvk_dir/d3d11.dll" ]]; then
      echo "steam-terakan-run: dxgi.dll and d3d11.dll are required in $dxvk_dir" >&2
      exit 1
    fi
  fi
}

cleanup_dxvk_links() {
  local link
  for link in "${created_dxvk_links[@]}"; do
    if [[ -L "$link" ]]; then
      local resolved
      resolved=$(readlink -f -- "$link" 2>/dev/null || true)
      case "$resolved" in
        "$dxvk_dir"/*) rm -f -- "$link" ;;
      esac
    fi
  done
  created_dxvk_links=()
}

stage_dxvk_for_command() {
  local argument game_executable=
  for argument in "$@"; do
    case "$argument" in
      *.[eE][xX][eE])
        if [[ -f "$argument" ]]; then
          game_executable=$(readlink -f -- "$argument")
        fi
        ;;
    esac
  done

  # Proton copies its bundled PE DXVK DLLs into the prefix after this launcher starts, and
  # WINEDLLPATH only selects Wine's Unix-side modules. Native Windows DLL lookup checks the
  # executable directory first, so temporary adjacent links reliably select DXVK-Sarek without
  # modifying Proton or its prefix.
  if [[ -z "$game_executable" ]]; then
    return
  fi

  local game_dir=${game_executable%/*}
  local dll source destination resolved
  for dll in dxgi.dll d3d11.dll d3d10core.dll; do
    source="$dxvk_dir/$dll"
    [[ -r "$source" ]] || continue
    destination="$game_dir/$dll"
    if [[ -e "$destination" || -L "$destination" ]]; then
      resolved=$(readlink -f -- "$destination" 2>/dev/null || true)
      if [[ "$resolved" != "$source" ]]; then
        echo "steam-terakan-run: refusing to replace existing $destination" >&2
        cleanup_dxvk_links
        return 1
      fi
      continue
    fi
    if ! ln -s -- "$source" "$destination"; then
      echo "steam-terakan-run: cannot stage DXVK-Sarek next to $game_executable" >&2
      cleanup_dxvk_links
      return 1
    fi
    created_dxvk_links+=("$destination")
  done
}

doctor=false
while (($#)); do
  case "$1" in
    --dxvk-sarek)
      if (($# < 2)); then
        echo "steam-terakan-run: --dxvk-sarek requires a directory" >&2
        exit 2
      fi
      dxvk_dir=$2
      use_dxvk=true
      shift 2
      ;;
    --dxvk-sarek=*)
      dxvk_dir=${1#*=}
      use_dxvk=true
      shift
      ;;
    --no-dxvk-sarek)
      use_dxvk=false
      shift
      ;;
    --install)
      install_launcher
      exit 0
      ;;
    --doctor)
      doctor=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ ! -x "$terakan_runner" ]]; then
  echo "steam-terakan-run: missing executable $terakan_runner" >&2
  exit 1
fi

if $use_dxvk; then
  resolve_dxvk
fi

if $doctor; then
  build_dir=${TERAKAN_BUILD_DIR:-"$repo_root/build-vulkan"}
  icd_dir="$build_dir/src/amd/terascale/vulkan"
  driver="$icd_dir/libvulkan_terascale.so"
  shopt -s nullglob
  icd_candidates=("$icd_dir"/terascale_devenv_icd.*.json)
  shopt -u nullglob

  printf 'repository: %s\n' "$repo_root"
  printf 'runner:     %s\n' "$terakan_runner"
  printf 'build:      %s\n' "$build_dir"
  printf 'driver:     %s%s\n' "$driver" "$([[ -r "$driver" ]] && printf ' [ok]' || printf ' [missing]')"
  if ((${#icd_candidates[@]} == 1)); then
    printf 'ICD:        %s [ok]\n' "${icd_candidates[0]}"
  else
    printf 'ICD:        expected one manifest, found %u [error]\n' "${#icd_candidates[@]}"
  fi
  if $use_dxvk && [[ -n "$dxvk_dir" ]]; then
    printf 'DXVK-Sarek: %s [ok]\n' "$dxvk_dir"
  elif $use_dxvk; then
    printf 'DXVK-Sarek: not found [optional]\n'
  else
    printf 'DXVK-Sarek: disabled\n'
  fi

  [[ -r "$driver" && ${#icd_candidates[@]} == 1 ]]
  exit
fi

if (($# == 0)); then
  usage >&2
  exit 2
fi

if $use_dxvk && [[ -n "$dxvk_dir" ]]; then
  export WINEDLLPATH="$dxvk_dir${WINEDLLPATH:+:$WINEDLLPATH}"
  native_overrides='d3d11=n;d3d10=n;d3d10core=n;dxgi=n'
  export WINEDLLOVERRIDES="$native_overrides${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
  stage_dxvk_for_command "$@"
fi

if ((${#created_dxvk_links[@]} == 0)); then
  exec "$terakan_runner" -- "$@"
fi

trap cleanup_dxvk_links EXIT
set +e
"$terakan_runner" -- "$@"
status=$?
set -e
cleanup_dxvk_links
trap - EXIT
exit "$status"
