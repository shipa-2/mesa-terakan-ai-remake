#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
build_dir=${TERAKAN_BUILD_DIR:-"$repo_root/build-vulkan"}
run_gpu=true
run_cube=false

usage() {
  cat <<'EOF'
usage: bin/terakan-test [--unit-only] [--vkcube]

Run focused unit tests and, by default, query the real GPU through the local
Terakan ICD. The GPU suite also checks that the BC6H oracle fails when its
expected result is deliberately corrupted. --vkcube adds a ten-second
windowed smoke test.
EOF
}

while (($#)); do
  case "$1" in
    --unit-only) run_gpu=false ;;
    --vkcube) run_cube=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "terakan-test: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

"$repo_root/bin/terakan-build"

cpu_tests=(
  terakan_sfn_lowering
  terakan_hw_config_loop_constants
  terakan_descriptor_buffer
  terakan_vertex_input
)
meson test -C "$build_dir" --print-errorlogs "${cpu_tests[@]}"

if ! $run_gpu; then
  exit 0
fi
if ! command -v vulkaninfo >/dev/null; then
  echo "terakan-test: vulkaninfo is required for the GPU test" >&2
  exit 1
fi

gpu_tests=(
  terakan_image_array_copy
  terakan_instance_dynamic_ssbo
  terakan_bc6_cube
  terakan_bc6_cube_single_level_views
  terakan_bc6_array_view
  terakan_compute_loop
  terakan_formatless_image_store
  terakan_dynamic_offset_bounds
  terakan_clip_distance
  terakan_depth_readback
  terakan_depth_msaa_fetch
  terakan_depth_resolve
  terakan_depth_stencil_resolve
  terakan_stencil_msaa_fetch
  terakan_stencil_readback
  terakan_stencil_fetch
  terakan_physical_device_properties
)
meson test -C "$build_dir" --print-errorlogs --num-processes 1 "${gpu_tests[@]}"

bc6_dir="$build_dir/src/amd/terascale/vulkan"
set +e
timeout --signal=TERM --kill-after=2 20 \
  "$repo_root/bin/terakan-run" \
  "$bc6_dir/terakan_bc6_cube_test" \
  "$bc6_dir/terakan_bc6_cube.vert.spv" \
  "$bc6_dir/terakan_bc6_cube.frag.spv" \
  --corrupt-expectation
bc6_negative_status=$?
set -e
if ((bc6_negative_status != 1)); then
  echo "terakan-test: BC6H negative control returned $bc6_negative_status, expected 1" >&2
  exit 1
fi
echo "terakan-test: BC6H negative control rejected the corrupted oracle as expected"

summary=$(mktemp --tmpdir terakan-vulkaninfo.XXXXXX)
trap 'rm -f -- "$summary"' EXIT
timeout --signal=TERM --kill-after=2 20 \
  "$repo_root/bin/terakan-run" vulkaninfo --summary | tee "$summary"

if ! grep -Eiq 'device(Name)?[[:space:]]*=.*(Terakan|CAICOS)' "$summary"; then
  echo "terakan-test: local Terakan/CAICOS device was not reported" >&2
  exit 1
fi

if $run_cube; then
  if ! command -v vkcube >/dev/null; then
    echo "terakan-test: vkcube is not installed" >&2
    exit 1
  fi
  set +e
  timeout --signal=TERM --kill-after=2 10 \
    "$repo_root/bin/terakan-run" vkcube
  cube_status=$?
  set -e
  if ((cube_status != 0 && cube_status != 124)); then
    echo "terakan-test: vkcube failed with status $cube_status" >&2
    exit 1
  fi
  echo "terakan-test: vkcube remained alive for the ten-second smoke window"
fi
